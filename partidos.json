<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transmisión en Vivo - Partidos</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }
        h1, h2 {
            text-align: center;
            color: #00ffcc;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }
        .match-card {
            background-color: #1e1e1e;
            border-radius: 8px;
            padding: 15px;
            width: 100%;
            max-width: 550px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        select, button {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
        }
        button:hover, select:hover {
            background-color: #444;
        }
        iframe, video {
            width: 100%;
            height: 315px;
            background-color: #000;
            margin-top: 15px;
            border: none;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <h1>Transmisiones en Vivo</h1>

    <div class="container">
        <!-- BARCELONA VS REAL MADRID -->
        <div class="match-card">
            <h2>⚽ Barcelona vs. Real Madrid</h2>
            <label for="select-rm-fcb">Selecciona una opción de video:</label>
            <select id="select-rm-fcb">
                <option value="https://s2.bufaloweb.com/bufalo9/tracks-v4a1/mono.ts.m3u8">Opción 1 (Bufalo)</option>
                <option value="https://jjyop200816-lang.github.io/hondurastv_juegos/asiria8.html">Opción 2 (Asiria 8)</option>
                <option value="https://jjyop200816-lang.github.io/hondurastv_juegos/zdsports.html">Opción 3 (ZD Sports)</option>
                <option value="http://190.61.101.11:7050/play/a04g/index.m3u8?hls">Opción 4 (HLS)</option>
                <option value="http://45.186.254.75:8000/play/a0en/index.m3u8">Opción 5 (HLS)</option>
                <option value="http://38.188.186.47:4000/play/Ji198/index.m3u8">Opción 6 (HLS)</option>
            </select>
            <button onclick="cambiarStream('rm-fcb', 'select-rm-fcb')">Cargar Transmisión</button>
            <iframe id="frame-rm-fcb" src="https://jjyop200816-lang.github.io/hondurastv_juegos/asiria8.html" allowfullscreen></iframe>
        </div>

        <!-- INDEPENDIENTE VS BOCA JUNIORS -->
        <div class="match-card">
            <h2>⚽ Independiente vs. Boca Juniors</h2>
            <label for="select-ind-boca">Selecciona una opción de video:</label>
            <select id="select-ind-boca">
                <option value="https://jjyop200816-lang.github.io/hondurastv_juegos/asiria3.html">Opción 1 (Asiria 3)</option>
            </select>
            <button onclick="cambiarStream('ind-boca', 'select-ind-boca')">Cargar Transmisión</button>
            <iframe id="frame-ind-boca" src="https://jjyop200816-lang.github.io/hondurastv_juegos/asiria3.html" allowfullscreen></iframe>
        </div>
    </div>

    <script>
        function cambiarStream(matchId, selectId) {
            const select = document.getElementById(selectId);
            const iframe = document.getElementById('frame-' + matchId);
            const url = select.value;
            iframe.src = url;
        }
    </script>

</body>
</html>
